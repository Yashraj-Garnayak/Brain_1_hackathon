# ---------------------------------------------------------------------------
# TILE RUSH local environment
# Copy to .env (or .env.local) and fill the values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Neon Postgres. DATABASE_URL is the pooled connection used by the API;
# DATABASE_URL_UNPOOLED is used by migrations and seed scripts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Shared HMAC secret for short-lived 1v1 tickets.
# Generate once: openssl rand -base64 32
# Put the SAME value in the Cloudflare Worker:
#   printf '%s\n' "$MATCH_SECRET" | npx wrangler secret put MATCH_SECRET --config worker/wrangler.toml
MATCH_SECRET=replace-with-a-long-random-string

# Public URL of the Cloudflare Worker that owns matchmaking + rooms.
MATCH_URL=https://tile-rush.text-udaykumar.workers.dev

# Ultrahuman Partner API token for the ring owner.
# The API sends it as the raw Authorization header (no "Bearer " prefix).
ULTRAHUMAN_TOKEN=
# Tile Rush username whose ring data should be attached to runs.
ULTRAHUMAN_USERNAME=

# Optional. `vercel env pull` writes this automatically; do not hand-edit.
VERCEL_OIDC_TOKEN=
